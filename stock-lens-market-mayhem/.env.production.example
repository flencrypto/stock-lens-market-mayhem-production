# Domain used by Caddy and app URL settings
DOMAIN=your-subdomain.duckdns.org

# Email used by ACME/Let's Encrypt notifications
EMAIL=you@example.com

# Keep demo for testing; switch to licensed before real launch
MARKET_PROVIDER=demo
QUOTE_CACHE_SECONDS=60

# Optional app settings
APP_NAME=Mr.FLEN Stock-LENS
STARTING_BALANCE=1000
DAILY_TRADE_LIMIT=1
SESSION_COOKIE_NAME=stocklens_session
FACEBOOK_GROUP_URL=https://www.facebook.com/groups/your-group

# Required when MARKET_PROVIDER=licensed
# MARKET_DATA_BASE_URL=https://your-licensed-data-provider.example
# MARKET_DATA_API_KEY=replace_me
