# Server
PORT=8787
NODE_ENV=production
PUBLIC_BASE_URL=https://your-domain.example
FACEBOOK_GROUP_URL=https://www.facebook.com/groups/your-stock-lens-group

# Market data
# demo = deterministic no-key sandbox prices for local/testing
# yahoo = public Yahoo chart endpoint, useful for personal testing only; use licensed data for production.
MARKET_PROVIDER=demo
QUOTE_CACHE_SECONDS=60

# Production market data adapter placeholders
# MARKET_PROVIDER=licensed
# MARKET_DATA_BASE_URL=https://your-licensed-data-provider.example
# MARKET_DATA_API_KEY=replace_me

# Security / auth
# In production, use a real session layer and verify Facebook-signed player payloads server-side.
SESSION_COOKIE_NAME=stocklens_session
CORS_ALLOW_ORIGIN=https://your-domain.example

# App branding
APP_NAME=Mr.FLEX Stock-LENS
STARTING_BALANCE=1000
DAILY_TRADE_LIMIT=1
